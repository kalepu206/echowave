# Copy this file to `.env` and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values are public by design (they identify your Firebase project, they are not passwords).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Shown on the Privacy, Terms and Contact pages
VITE_CONTACT_EMAIL=support@example.com
# Name shown as the Grievance Officer on the Terms page (required for intermediaries in India)
VITE_GRIEVANCE_OFFICER=Your Name
