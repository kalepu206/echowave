# Optional settings baked into the website at build time.
# In Cloudflare: Workers & Pages > echowave > Settings > Build > Variables (or keep the defaults).

# Shown on the Privacy, Terms and Contact pages
VITE_CONTACT_EMAIL=support@echowaveai.com
# Name shown as the Grievance Officer on the Terms page (required for intermediaries in India)
VITE_GRIEVANCE_OFFICER=Your Name
