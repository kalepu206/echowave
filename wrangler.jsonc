// Cloudflare configuration for EchoWave.
// Replace every value marked REPLACE_ME (see README, steps 4-7).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echowave",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Your domain (must be active in this Cloudflare account)
  "routes": [
    { "pattern": "echowaveai.com", "custom_domain": true },
    { "pattern": "www.echowaveai.com", "custom_domain": true }
  ],

  // The React app (built into ./dist) is served as static files.
  // /api/* and /.well-known/* go to the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },

  // Database (create with: npx wrangler d1 create echowave)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echowave",
      "database_id": "ec0bbd6b-a878-4938-aecc-4084499459ef",
      "migrations_dir": "migrations"
    }
  ],

  // Image storage (create with: npx wrangler r2 bucket create echowave-images)
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "echowave-images" }
  ],

  "vars": {
    // Google sign-in: OAuth client ID from Google Cloud Console (public, not a secret)
    "GOOGLE_CLIENT_ID": "",
    // Main address of the site; Google sends people back here after login
    "APP_ORIGIN": "https://echowaveai.com",
    // Comma-separated Firebase user ids that can use /admin
    "ADMIN_UIDS": "",
    // Gemini model used for moderation, tagging and summaries
    "GEMINI_MODEL": "gemini-flash-latest",
    // How long a broadcast stays visible
    "POST_TTL_HOURS": "48",
    // A post is hidden automatically after this many reports
    "REPORT_HIDE_THRESHOLD": "3",
    // Android app (fill in after packaging with PWABuilder, README step 8)
    "ANDROID_PACKAGE": "",
    "ANDROID_SHA256": ""
  },

  // Cleanup of expired broadcasts every 6 hours
  "triggers": { "crons": ["0 */6 * * *"] },

  "observability": { "enabled": true }

  // Secrets (never put in this file): add in Cloudflare dashboard > echowave > Settings > Variables and Secrets
  //   GEMINI_API_KEY, GOOGLE_CLIENT_SECRET
}
